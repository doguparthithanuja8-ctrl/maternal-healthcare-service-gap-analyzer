# ==============================================================================
# Environment Configuration Template
# ==============================================================================

# Backend API Base URL for React Frontend
VITE_API_BASE_URL="http://localhost:8080/api"

# Set to "true" only when Spring Boot is running; default demo uses bundled local data
VITE_ENABLE_BACKEND="false"

# Default Geographic Center for Map (Latitude, Longitude, Zoom)
VITE_MAP_DEFAULT_LAT="23.684994"
VITE_MAP_DEFAULT_LNG="89.500000"
VITE_MAP_DEFAULT_ZOOM="7"

# Database Configuration (for Backend Spring Boot)
SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/maternal_health_analyzer?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
SPRING_DATASOURCE_USERNAME="root"
SPRING_DATASOURCE_PASSWORD=""

# Server Ports
PORT="3000"
BACKEND_PORT="8080"
